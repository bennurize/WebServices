{
  "name": "@recipes/messaging",
  "version": "0.0.1",
  "private": true,
  "description": "NATS JetStream publication and consumption of the events",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@recipes/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@nats-io/jetstream": "*",
    "@nats-io/transport-node": "*",
    "@nestjs/common": "*"
  },
  "devDependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@recipes/eslint": "workspace:*",
    "@recipes/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3"
  }
}
