{
  "name": "@recipes/recipe",
  "version": "0.0.1",
  "private": true,
  "description": "Recipes CRUD (gRPC) and enrichment events",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/microservices": "12.2.0",
    "@nestjs/mongoose": "12.0.0",
    "@recipes/config": "workspace:*",
    "@recipes/contracts": "workspace:*",
    "@recipes/messaging": "workspace:*",
    "mongoose": "9.11.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@recipes/eslint": "workspace:*",
    "@recipes/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
