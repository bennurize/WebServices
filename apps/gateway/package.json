    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/microservices": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@recipes/config": "workspace:*",
    "@recipes/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@recipes/eslint": "workspace:*",
    "@recipes/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
