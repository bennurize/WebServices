{
  "name": "@recipes/gateway",
  "version": "0.0.1",
  "private": true,
  "description": "Public entry point: REST API, authentication, rate limiting, API composition",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
